// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id   String @id @default(cuid())
  name String @unique

  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovementType {
  id   String @id @default(cuid())
  name String

  movements Movement[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ItemType {
  id String @id @default(cuid())
  name String
  items Item[]
}

model Item {
  id            String   @id @default(cuid())
  name          String
  description   String?
  securityStock Decimal  @default(0)
  shelfLife     Int?
  color         String?
  active        Boolean  @default(true)
  purchasePrice Decimal? @db.Decimal(10, 3)

  idTypeItem String
  idUnit     String
  idSupplier String

  type ItemType @relation(fields: [idTypeItem], references: [id])
  unit     Unit     @relation(fields: [idUnit], references: [id])
  supplier Supplier @relation(fields: [idSupplier], references: [id])

  stocks    Stock[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(10, 3)

  idItem String @unique

  item Item @relation(fields: [idItem], references: [id])

  movements Movement[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Movement {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(10, 3)

  idStock        String
  idMovementType String

  stock        Stock        @relation(fields: [idStock], references: [id])
  movementType MovementType @relation(fields: [idMovementType], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
